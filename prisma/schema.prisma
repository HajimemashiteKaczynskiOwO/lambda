generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id             String   @id @default(uuid())
  username       String   @unique
  password       String
  wins           Int      @default(0)
  losses         Int      @default(0)
  matches        Int      @default(0)
  winrate        Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdGames   Game[]   @relation("CreatedGames")
  gamesAsPlayer1 Game[]   @relation("Player1Games")
  gamesAsPlayer2 Game[]   @relation("Player2Games")
  winsAsWinner   Game[]   @relation("WinnerGames")
  profilePicture Image?

}

model Game {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  createdById String
  player1Id   String
  player1Name String
  player2Id   String
  player2Name String
  winnerName  String
  winnerId    String
  createdBy   Player   @relation("CreatedGames", fields: [createdById], references: [id])
  player1     Player   @relation("Player1Games", fields: [player1Id], references: [id])
  player2     Player   @relation("Player2Games", fields: [player2Id], references: [id])
  winner      Player   @relation("WinnerGames", fields: [winnerId], references: [id])
}

model Image {
  id        String   @id @default(uuid())
  url       String
  createdAt DateTime @default(now())
  encoding String
  
  playerId  String @unique
  player   Player   @relation(fields: [playerId], references: [id])
}