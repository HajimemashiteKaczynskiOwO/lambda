// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  wins      Int      @default(0)
  losses    Int      @default(0)
  matches   Int      @default(0)
  winrate   Float    @default(0) // Stored as decimal (0.0 - 1.0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  gamesAsPlayer1 Game[] @relation("Player1Games")
  gamesAsPlayer2 Game[] @relation("Player2Games")
  winsAsWinner   Game[] @relation("WinnerGames")

  createdGames Game[] @relation("CreatedGames")
}

model Game {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  createdById String
  createdBy   Player   @relation("CreatedGames", fields: [createdById], references: [id])

  // Relations to Player
  player1Id   String
  player1Name String
  player2Id   String
  player2Name String
  winnerName  String
  winnerId    String

  player1 Player @relation("Player1Games", fields: [player1Id], references: [id])
  player2 Player @relation("Player2Games", fields: [player2Id], references: [id])
  winner  Player @relation("WinnerGames", fields: [winnerId], references: [id])
}
